# Get an instant 30-day sandbox key at https://revmachina.ai/partner-access
# Pick use_case: voice_platform, dialer, or custom (these are sandbox-eligible).
REVMACHINA_API_KEY=rm_test_revm_REPLACE_ME

# The webhook listener binds to this port. Default 4000.
WEBHOOK_LISTENER_PORT=4000

# Public URL for the webhook subscription. The cron worker fans deliveries
# to this URL; the local Express/Flask listener verifies the HMAC and prints.
# For local-only testing, leave blank — the demo uses /v1/webhooks/sandbox/
# trigger-demo-event which fires against any URL the subscription points to.
# WEBHOOK_PUBLIC_URL=https://your-ngrok-or-tunnel.example.com
